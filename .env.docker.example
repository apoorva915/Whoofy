# Docker compose example env
# Copy to .env and fill in your values. docker-compose up will use these.
NODE_ENV=production

# ML_SERVICE_URL is set automatically by docker-compose to http://ml:8000 (do not override)

# Choose ONE:
# - Supabase/remote Postgres (recommended): set DATABASE_URL accordingly
# - Local compose Postgres: use:
#   DATABASE_URL=postgresql://postgres:postgres@db:5432/postgres
# Supabase: use your connection string from Dashboard → Settings → Database
# Or use compose Postgres: postgresql://postgres:postgres@db:5432/postgres
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres
# Optional external integrations (Docker compose maps GEMINI_API_KEY_NEW -> GEMINI_API_KEY in container)
GEMINI_API_KEY_NEW=
APIFY_API_TOKEN=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
SHAZAM_API_KEY=
SHAZAM_API_HOST=shazam-api7.p.rapidapi.com

# Redis (for view-tracking queue). In Docker use host "redis"; for local dev use "localhost" or omit.
REDIS_HOST=redis
REDIS_PORT=6379

# Optional tuning
FRAME_ANALYSIS_CONCURRENCY=3
API_BASE_URL=http://localhost:3000

# Instaloader (optional - for private Instagram profiles; ML service uses this)
# Leave empty for public reels only. Instaloader is primary scraper; Apify is fallback.
# INSTALOADER_USERNAME=
# INSTALOADER_PASSWORD=

# Google Vision (optional - for Frame Analysis tab, Google Vision mode)
# If using service account JSON, mount it in docker-compose and set:
# GOOGLE_APPLICATION_CREDENTIALS=/app/google-service-account.json

